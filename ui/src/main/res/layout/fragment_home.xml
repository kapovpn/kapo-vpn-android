<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Graphite/Teal prototype: status pill, dot world map hero with the
     route flowing out of the connect sphere, hop pill, transfer totals.
     Background is transparent so the state gradient in MainActivity shows
     through and the whole app changes color on connect. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KAPO"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvLogoVpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" VPN"
            android:textColor="@color/amber"
            android:textSize="20sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <View
                android:id="@+id/badgeDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_badge_dot"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOT PROTECTED"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.16"/>
        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLING CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TAP THE SPHERE TO CONNECT"
                android:textColor="@color/text_faint"
                android:textSize="9sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:gravity="center"
                android:layout_marginBottom="2dp"/>

            <!-- HERO: the route rings the orb (Route Atlas) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <org.amnezia.awg.ui.KapoRouteRingView
                    android:id="@+id/routeRing"
                    android:layout_width="296dp"
                    android:layout_height="296dp"
                    android:layout_gravity="center"/>

                <org.amnezia.awg.ui.KapoOrbButton
                    android:id="@+id/btnConnect"
                    android:layout_width="212dp"
                    android:layout_height="212dp"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/teal_ink"
                android:textSize="21sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="-6dp"/>

            <TextView
                android:id="@+id/tvTimerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECTED"
                android:textColor="@color/text_faint"
                android:textSize="9sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="10dp"/>

            <!-- hop pill: shared dark well, segments draw their own state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_hop_track"
                android:padding="3dp"
                android:layout_marginBottom="12dp">
                <org.amnezia.awg.ui.KapoHopButton
                    android:id="@+id/hop1Btn"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="50dp"/>
                <org.amnezia.awg.ui.KapoHopButton
                    android:id="@+id/hop2Btn"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="50dp"/>
                <org.amnezia.awg.ui.KapoHopButton
                    android:id="@+id/hop3Btn"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="50dp"/>
            </LinearLayout>

            <!-- route chain: one row per hop server, filled in code -->
            <org.amnezia.awg.ui.KapoCard
                android:id="@+id/cardRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ROUTE" android:textColor="@color/text_faint"
                        android:textSize="8sp" android:fontFamily="sans-serif-rounded"
                        android:textStyle="bold" android:letterSpacing="0.22"
                        android:layout_marginBottom="10dp"/>
                    <LinearLayout
                        android:id="@+id/routeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </org.amnezia.awg.ui.KapoCard>

            <!-- trust strip: minimal, on-brand footer that fills the lower area
                 when the route is short (1-2 hops) instead of leaving it empty -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_accent_teal"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANONYMOUS · ENCRYPTED · NO LOGS"
                    android:textColor="@color/text_faint"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-rounded"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Traffic obfuscated with AmneziaWG — to a network it looks like nothing at all."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="No logs" android:textColor="@color/text_muted"
                        android:textSize="11sp" android:background="@drawable/bg_pill_glass"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Crypto only" android:textColor="@color/text_muted"
                        android:textSize="11sp" android:background="@drawable/bg_pill_glass"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Kill switch" android:textColor="@color/text_muted"
                        android:textSize="11sp" android:background="@drawable/bg_pill_glass"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
