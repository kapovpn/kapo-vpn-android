<?xml version="1.0" encoding="utf-8"?>
<!-- KAPO Cyber login: K glyph + brand, "Enter your code", segmented code cells
     (built in LoginActivity, with a transparent input overlay), gradient
     Activate button, feature chips. IDs kept for LoginActivity. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_state_off"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- brand: glyph + KAPO VPN -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="K"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_glyph"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAPO"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.14"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" VPN"
                android:textColor="@color/teal_ink"
                android:textSize="26sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:letterSpacing="0.14"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your code"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:layout_marginTop="22dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No email. No account.\nAnonymous, crypto-only privacy."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"/>

        <!-- code field: a single, always-typable box (monospace, cyan focus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:layout_marginTop="26dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_key"
                android:tint="@color/teal"
                android:layout_marginEnd="10dp"/>
            <EditText
                android:id="@+id/etAccountNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="XXXX-XXXX-XXXX-XXXX"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@null"
                android:maxLines="1"
                android:maxLength="19"
                android:letterSpacing="0.10"/>
        </LinearLayout>

        <!-- activate -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Activate &amp; Connect"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textAllCaps="false"
            android:background="@drawable/bg_signin_dim"
            android:stateListAnimator="@null"
            android:layout_marginTop="22dp"
            android:enabled="false"/>

        <!-- feature chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No logs"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crypto only"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multi-hop"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"/>
        </LinearLayout>

        <!-- new here -->
        <Button
            android:id="@+id/btnBuy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New here?  Get a code"
            android:textColor="@color/teal_ink"
            android:textSize="12sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
